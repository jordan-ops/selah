# ---- build / interpreter junk ----
__pycache__/
*.pyc
*.pyo

# ---- local backups: git itself is the history ----
*.bak
*.bak-*
*.orig
*~
*.swp

# ---- generated by scripts/switch-theme.sh on every theme apply ----
# Re-created by install.sh, so a fresh clone never renders stale colours.
config/hypr/colors.lua
config/kitty/current-theme.conf
config/gtk-3.0/theme.css

# ---- nested clone: AstroNvim template's own repo ----
# Stays on disk (so :AstroUpdate keeps working) but is never committed
# into this repository as a gitlink.
config/nvim/.git/

# ---- machine-local ----
local/bin/gh
