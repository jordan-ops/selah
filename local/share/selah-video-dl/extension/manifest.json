{
  "manifest_version": 3,
  "name": "Selah Video Downloader",
  "version": "1.0",
  "description": "Ctrl+D saves the playing video into ~/Videos via yt-dlp",
  "permissions": ["nativeMessaging", "notifications"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": { "128": "icon.png" }
}
