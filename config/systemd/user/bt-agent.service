[Unit]
Description=Persistent BlueZ pairing agent + pairable watchdog
# The system bus has to exist before an agent can be registered on it.
After=dbus.service
Wants=dbus.service

[Service]
Type=simple
ExecStart=/home/jordanzo/.dotfiles/config/systemd/user/bt-agent.sh
# bluetoothctl exiting = the agent is gone; come straight back up.
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
